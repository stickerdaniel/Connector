{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Windows Build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend/windows/src/Connector.Windows"
            },
            "problemMatcher": "$msCompile"
        },
